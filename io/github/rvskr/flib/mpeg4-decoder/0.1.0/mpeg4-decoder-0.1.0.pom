  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.rvskr.flib</groupId>
  <artifactId>mpeg4-decoder</artifactId>
  <version>0.1.0</version>
  <packaging>aar</packaging>
  <name>FLib MPEG-4 Part 2 decoder</name>
  <description>Media3 software video renderer for MPEG-4 Part 2 on Android</description>
  <url>https://github.com/rvskr/flib</url>
  <licenses>
